---
import "@/styles/globals.css";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import "@fontsource/inter/400.css";
import "@fontsource/inter/700.css";
import "@fontsource/noto-sans-jp/400.css";
import "@fontsource/noto-sans-jp/700.css";
import AnimationProvider from "@/components/AnimationProvider";
import AppBar from "@/components/AppBar";
import Background3D from "@/components/Background3D";
import Crosshair from "@/components/Crosshair";
import FocusOverlay from "@/components/FocusOverlay";
import Footer from "@/components/Footer";
import Provider from "@/components/Provider";
import ScrollBlur from "@/components/ScrollBlur";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Clover_Midori",
	description = "Clover_Midori（クローバーみどり）のポートフォリオ。VRChat 向けツールとリアルタイム配信基盤をつくるエンジニア。",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-pp-neue-montreal" />
    <Font cssVariable="--font-geist-mono" preload/>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:image" content="/icon_512.png" />
    <ClientRouter />
  </head>
  <body>
    <!-- Persisted across page navigations so Three.js / hints are not re-initialised -->
    <Crosshair client:load transition:persist="crosshair" />
    <FocusOverlay client:load transition:persist="focus-overlay" />
    <Background3D client:load transition:persist="background-3d" />
    <ScrollBlur client:load transition:persist="scroll-blur" />
    <Provider client:load>
      <AppBar client:load />
      <AnimationProvider client:load>
        <slot />
        <Footer client:load />
      </AnimationProvider>
    </Provider>
  </body>
</html>
